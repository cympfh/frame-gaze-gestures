[Unit]
Description=frame-gaze-gestures (eye gestures on the Steam Frame to VRChat OSC / commands)
# frameeyeosc の出力を使うので、SteamVR（と frameeyeosc）が動いている間だけ動かす
After=steamvr.service frameeyeosc.service
PartOf=steamvr.service

[Service]
ExecStart=/usr/bin/python3 %h/.local/opt/frame-gaze-gestures/frame-gaze-gestures.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=steamvr.service
